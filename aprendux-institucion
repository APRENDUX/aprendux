      <tbody>${CURSOS.map(c => {
        const al = ALUMNOS.filter(a => a.curso === c);
        const cp = al.filter(a => a.perfil);
        const cuenta = {}; cp.forEach(a => { const k = predominante(a).k; cuenta[k] = (cuenta[k] || 0) + 1; });
        const topK = Object.entries(cuenta).sort((x, y) => y[1] - x[1])[0];
        const f = topK && FORMAS.find(x => x.k === topK[0]);
        const al3 = al.filter(a => a.tests.estilos && a.tests.rc1 !== null && a.tests.rc2 !== null).length;
