function marcarNav(){ document.querySelectorAll('.side button').forEach(b => b.classList.toggle('on', b.dataset.v === VISTA)); }
function ir(v){ VISTA = v; marcarNav(); pintar(); window.scrollTo(0, 0); }
function elegirCurso(c){ CURSO = c; pintar(); }
Object.assign(window, { ir, elegirCurso });

function chipsCursos(){
  const l = MIS_CURSOS();
  if(l.length <= 1) return l.length ? `<div class="cursos"><button type="button" class="on">${esc(l[0])}</button></div>` : '';
  return `<div class="cursos" role="tablist" aria-label="Curso">${l.map(c =>
    `<button type="button" class="${c === CURSO ? 'on' : ''}" onclick="elegirCurso('${jsq(c)}')">${esc(c)}</button>`).join('')}</div>`;
}
function sinCursos(){
  return `<div class="card vacio">${ROL === 'directivo'
    ? 'Todavía no hay cursos. Creá el primero en <a href="#" onclick="ir(\'cursos\');return false">Cursos y códigos</a>.'
    : 'Todavía no tenés cursos asignados. Pedile a un directivo de tu escuela que te asigne los tuyos.'}</div>`;
}
function sinAlumnos(){
  const c = CURSO_INFO[CURSO];
  return `<div class="card vacio">Todavía no se sumó ningún alumno${c ? ` a ${esc(CURSO)}` : ''}.<br>
    ${c ? `Pasales este código para que lo escriban en su perfil de aprendux.ar: <span class="codigo">${esc(c.codigo)}</span>` : 'Los códigos de cada curso están en <a href="#" onclick="ir(\'cursos\');return false">Cursos y códigos</a>.'}</div>`;
}
function pintar(){
  const todas = alumnosDelCurso().flatMap(alertasDe).filter(x => !VISTAS.has(x.id));
  const b = document.getElementById('badge-alertas');
  b.textContent = todas.length || ''; b.style.display = todas.length ? '' : 'none';
  const m = document.getElementById('main');
  if(VISTA !== 'cursos' && !CURSOS.length){ m.innerHTML = sinCursos(); return; }
  m.innerHTML = { resumen: vistaResumen, alumnos: vistaAlumnos, alertas: vistaAlertas, examenes: vistaExamenes, cursos: vistaCursos }[VISTA]();
}

