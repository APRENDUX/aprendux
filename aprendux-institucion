      ${a.planes.length ? a.planes.map(p => { const d = diasHasta(p.fecha); return `<div class="examen"><div><b>${esc(p.materia)}</b>
        <span>${d < 0 ? 'Ya fue (' + fechaCorta(p.fecha) + ')' : d === 0 ? 'Es hoy' : 'Faltan ' + d + ' días'}</span></div>
        <span><span class="mini"><i style="width:${pct(p.hechos, p.total)}%"></i></span>${p.hechos}/${p.total}</span></div>`; }).join('')
      : '<p class="sub" style="margin:0">Todavía no armó planes de estudio.</p>'}
    </div>
    <div class="card">
      <h3>🗒️ Notas</h3>
      ${a.notas.length ? a.notas.map(n => `<div class="examen"><div><b>${esc(n.materia)}${n.materia && n.titulo ? ' · ' : ''}${esc(n.titulo)}</b><span>${fechaCorta(n.fecha)}${n.origen === 'alumno' ? ' · la cargó el alumno' : ''}</span></div><b style="font-size:18px">${fmtNota(n.nota)}</b></div>`).join('') : '<p class="sub">Sin notas cargadas.</p>'}
      <div class="fila2" style="margin-top:.8rem">
        <div class="campo"><label for="fn-mat">Materia</label><select id="fn-mat">${MATERIAS.map(m => `<option>${esc(m)}</option>`).join('')}</select></div>
        <div class="campo"><label for="fn-nota">Nota</label><input id="fn-nota" type="number" min="1" max="10" step="0.5" placeholder="1 a 10"></div>
      </div>
      <button class="btn" onclick="cargarNotaAlumno('${a.id}')">Cargar nota</button>
    </div>`;
  document.getElementById('velo').style.display = 'block';
  requestAnimationFrame(() => document.getElementById('ficha').classList.add('abierta'));
}
function cerrarFicha(){
  document.getElementById('ficha').classList.remove('abierta');
  document.getElementById('velo').style.display = 'none';
}
async function cargarNotaAlumno(id){
  const a = ALUMNOS.find(x => x.id === id);
  const v = parseFloat(document.getElementById('fn-nota').value);
  if(!(v >= 1 && v <= 10)){ toast('Poné una nota del 1 al 10'); return; }
  const materia = document.getElementById('fn-mat').value;
  const { error } = await sb.from('notas').insert({ alumno_id: a.id, curso_id: a.curso_id, materia, titulo: 'Nota', nota: v, fecha: enDias(0), cargada_por: YO.id });
  if(error){ toast('No se pudo guardar la nota'); console.warn(error); return; }
  await recargarDatos();
  toast('Nota cargada ✓'); abrirFicha(id); pintar();
}
Object.assign(window, { abrirFicha, cerrarFicha, cargarNotaAlumno });
document.addEventListener('keydown', e => { if(e.key === 'Escape') cerrarFicha(); });

// ══════════════════════════════════════════════════════════════
//  ALERTAS
// ══════════════════════════════════════════════════════════════
function vistaAlertas(){
  const orden = { critico: 0, serio: 1, aviso: 2 };
  const l = alumnosDelCurso().flatMap(alertasDe).filter(x => !VISTAS.has(x.id)).sort((a, b) => orden[a.nivel] - orden[b.nivel]);
  return `
    <div class="titulo"><div><h1>🔔 Alertas</h1><p>Lo que conviene mirar primero.</p></div></div>
    ${chipsCursos()}
    ${l.length ? ['critico', 'serio', 'aviso'].map(niv => {
      const g = l.filter(x => x.nivel === niv);
      if(!g.length) return '';
      return `<h3 style="font-size:15px;margin:1rem 0 .5rem;color:${COLOR_NIVEL[niv]}">${NOMBRE_NIVEL[niv]} · ${g.length}</h3>` + g.map(x => `
        <div class="alerta" style="--c:${COLOR_NIVEL[x.nivel]}"><span class="ic">${x.ic}</span>
          <div class="tx"><b>${esc(x.alumno.nombre)}${esTodos() ? ' · ' + esc(x.alumno.curso) : ''}: ${esc(x.txt)}</b><span>${esc(x.det)}</span></div>
          <div style="display:flex;gap:.4rem;flex-wrap:wrap;justify-content:flex-end">
            <button class="btn claro chico" onclick="abrirFicha('${x.alumno.id}')">Ver alumno</button>
            <button class="btn chico" onclick="marcarVista('${jsq(x.id)}')">✓ Visto</button></div></div>`).join('');
    }).join('') : `<div class="card vacio">🎉 No hay alertas${alumnosDelCurso().length ? ' en este curso' : ''}.</div>`}`;
}
function marcarVista(id){ VISTAS.add(id); guardarVistas(); pintar(); toast('Marcada como vista'); }
window.marcarVista = marcarVista;

// ══════════════════════════════════════════════════════════════
//  EXÁMENES Y NOTAS
// ══════════════════════════════════════════════════════════════
function vistaExamenes(){
  const cursoForm = esTodos() ? CURSOS[0] : CURSO;
  const ex = EXAMENES.filter(e => esTodos() || e.curso === CURSO).filter(e => diasHasta(e.fecha) >= -30);
  return `
    <div class="titulo"><div><h1>📝 Exámenes y notas</h1><p>Anotá un examen para todo el curso y cargá las notas.</p></div></div>
    ${chipsCursos()}
    <div class="grid g2">
      <div class="card">
        <h3>➕ Anotar un examen</h3>
        <p class="sub">Le aparece en el calendario a cada alumno del curso, con su plan de estudio.</p>
        <div class="fila2">
          <div class="campo"><label for="fx-curso">Curso</label><select id="fx-curso">${CURSOS.map(c => `<option ${c === cursoForm ? 'selected' : ''}>${esc(c)}</option>`).join('')}</select></div>
          <div class="campo"><label for="fx-mat">Materia</label><select id="fx-mat">${MATERIAS.map(m => `<option>${esc(m)}</option>`).join('')}</select></div>
        </div>
        <div class="campo"><label for="fx-tit">Título</label><input id="fx-tit" maxlength="120" placeholder="Ej: Prueba de la Revolución de Mayo"></div>
        <div class="fila2">
          <div class="campo"><label for="fx-fecha">Fecha</label><input id="fx-fecha" type="date" min="${enDias(0)}" value="${enDias(7)}"></div>
          <div class="campo"><label for="fx-tipo">¿Escrito u oral?</label><select id="fx-tipo"><option>Escrito</option><option>Oral</option><option>TP / entrega</option></select></div>
        </div>
        <div class="campo"><label for="fx-temas">Temas que entran</label><textarea id="fx-temas" rows="2" maxlength="1000" placeholder="Ej: causas, Primera Junta, Cabildo abierto"></textarea></div>
        <button class="btn" id="fx-btn" onclick="anotarExamen()">Anotar para el curso</button>
      </div>
      <div class="card">
        <h3>📅 Exámenes del curso</h3>
        <p class="sub">Tocá "Cargar notas" cuando ya lo tomaste.</p>
        ${ex.length ? ex.map(e => { const d = diasHasta(e.fecha); return `<div class="examen"><div><b>${esc(e.materia || '')}${e.materia ? ' · ' : ''}${esc(e.titulo)}</b>
          <span>${esc(e.curso)} · ${e.tipoTxt} · ${d < 0 ? 'fue el ' + fechaCorta(e.fecha) : d === 0 ? 'es hoy' : 'en ' + d + ' días (' + fechaCorta(e.fecha) + ')'}</span></div>
          <button class="btn claro chico" onclick="abrirNotas('${e.id}')">Cargar notas</button></div>`; }).join('')
        : '<p class="sub">No hay exámenes anotados.</p>'}
      </div>
    </div>
    <div id="carga-notas"></div>`;
}
async function anotarExamen(){
  const titulo = document.getElementById('fx-tit').value.trim();
  const fecha = document.getElementById('fx-fecha').value;
  if(!titulo || !fecha){ toast('Completá el título y la fecha'); return; }
  const curso = document.getElementById('fx-curso').value;
  const tipoSel = document.getElementById('fx-tipo').value;
  const btn = document.getElementById('fx-btn'); btn.disabled = true;
  const { error } = await sb.from('examenes_curso').insert({
    curso_id: CURSO_INFO[curso].id, materia: document.getElementById('fx-mat').value, titulo, fecha,
    tipo: tipoSel === 'TP / entrega' ? 'Entrega' : 'Examen',
    modalidad: tipoSel === 'Oral' ? 'oral' : tipoSel === 'Escrito' ? 'escrito' : null,
    temas: document.getElementById('fx-temas').value.trim() || null, creado_por: YO.id
  });
  btn.disabled = false;
  if(error){ toast('No se pudo anotar el examen'); console.warn(error); return; }
  await recargarDatos();
  toast(`Anotado ✓ · les llega a los ${ALUMNOS.filter(a => a.curso === curso).length} alumnos de ${curso}`);
  pintar();
}
async function abrirNotas(id){
  const e = EXAMENES.find(x => x.id === id);
  const al = ALUMNOS.filter(a => a.curso === e.curso);
  const { data: previas } = await sb.from('notas').select('alumno_id, nota').eq('examen_id', id);
  const nota = Object.fromEntries((previas || []).map(p => [p.alumno_id, p.nota]));
  document.getElementById('carga-notas').innerHTML = `
    <div class="card" style="margin-top:1rem">
      <h3>🗒️ Notas · ${esc(e.materia || '')} · ${esc(e.titulo)} (${esc(e.curso)})</h3>
      <p class="sub">Escribí la nota de cada uno. Las que dejes vacías no se cargan. A cada alumno le aparece en su calendario.</p>
      ${al.length ? `<table class="tabla" style="margin-bottom:1rem"><thead><tr><th>Alumno</th><th>Nota</th></tr></thead>
        <tbody>${al.map(a => `<tr style="cursor:default"><td class="nombre" data-l="Alumno">${esc(a.nombre)}</td>
          <td data-l="Nota"><input class="nota-in" type="number" min="1" max="10" step="0.5" data-a="${a.id}" value="${nota[a.id] ?? ''}"></td></tr>`).join('')}</tbody></table>
      <button class="btn" id="notas-btn" onclick="guardarNotas('${e.id}')">Guardar notas</button>` : '<p class="sub">Este curso todavía no tiene alumnos.</p>'}
    </div>`;
  document.getElementById('carga-notas').scrollIntoView({ behavior: 'smooth' });
}
async function guardarNotas(id){
  const e = EXAMENES.find(x => x.id === id);
  const filas = [];
  document.querySelectorAll('.nota-in').forEach(inp => {
    const v = parseFloat(inp.value);
    if(v >= 1 && v <= 10) filas.push({ alumno_id: inp.dataset.a, curso_id: e.curso_id, examen_id: e.id, materia: e.materia, titulo: e.titulo, nota: v, fecha: e.fecha, cargada_por: YO.id });
  });
  if(!filas.length){ toast('No cargaste ninguna nota'); return; }
  document.getElementById('notas-btn').disabled = true;
  const { error } = await sb.from('notas').upsert(filas, { onConflict: 'examen_id,alumno_id' });
  document.getElementById('notas-btn').disabled = false;
  if(error){ toast('No se pudieron guardar las notas'); console.warn(error); return; }
  await recargarDatos();
  toast(filas.length === 1 ? '1 nota guardada ✓' : `${filas.length} notas guardadas ✓`);
  pintar();
}
Object.assign(window, { anotarExamen, abrirNotas, guardarNotas });

// ══════════════════════════════════════════════════════════════
//  CURSOS Y CÓDIGOS (el directivo además crea cursos y suma docentes)
// ══════════════════════════════════════════════════════════════
function vistaCursos(){
  const dire = ROL === 'directivo';
  const lista = (INICIO.cursos || []).map(c => `<div class="cod-fila"><div><b>${esc(c.nombre)}</b><br><span class="sub" style="margin:0">${c.alumnos} alumno${c.alumnos === 1 ? '' : 's'}</span></div>
      <div style="display:flex;align-items:center;gap:.5rem"><span class="codigo">${esc(c.codigo)}</span>
      <button class="btn claro chico" onclick="copiarCodigo('${jsq(c.codigo)}')">Copiar</button></div></div>`).join('');
  return `
    <div class="titulo"><div><h1>🏫 Cursos y códigos</h1><p>Cada alumno escribe el código de su curso en su perfil de aprendux.ar y aparece acá.</p></div></div>
    <div class="grid g2">
      <div class="card">
        <h3>🔑 ${dire ? 'Cursos de la escuela' : 'Tus cursos'}</h3>
        <p class="sub">Pasales el código a los alumnos de cada curso.</p>
        ${lista || `<p class="sub">${dire ? 'Todavía no hay cursos.' : 'Todavía no tenés cursos asignados. Pedíselos a un directivo.'}</p>`}
      </div>
      ${dire ? `
      <div class="card">
        <h3>➕ Crear un curso</h3>
        <p class="sub">Se genera su código automáticamente.</p>
        <div class="campo"><label for="nc-nombre">Nombre del curso</label><input id="nc-nombre" maxlength="40" placeholder="Ej: 3° A"></div>
        <button class="btn" id="nc-btn" onclick="crearCurso()">Crear curso</button>
      </div>
      <div class="card">
        <h3>👩‍🏫 Sumar a alguien del equipo</h3>
        <p class="sub">Primero tiene que crear su cuenta en este panel. Después la sumás con su mail.</p>
        <div class="campo"><label for="eq-mail">Mail</label><input id="eq-mail" type="email" placeholder="docente@escuela.edu.ar"></div>
        <div class="campo"><label for="eq-nombre">Nombre (opcional)</label><input id="eq-nombre" maxlength="80"></div>
        <div class="campo"><label for="eq-rol">Rol</label><select id="eq-rol"><option value="docente">Docente</option><option value="directivo">Directivo</option></select></div>
        ${CURSOS.length ? `<label style="font-weight:700;font-size:14px">Cursos a cargo</label>
        <div class="checks">${(INICIO.cursos || []).map(c => `<label><input type="checkbox" class="eq-curso" value="${c.id}"> ${esc(c.nombre)}</label>`).join('')}</div>` : ''}
        <button class="btn" id="eq-btn" onclick="sumarEquipo()">Sumar al equipo</button>
      </div>` : ''}
    </div>`;
}
async function copiarCodigo(c){ try { await navigator.clipboard.writeText(c); toast('Código copiado ✓'); } catch(e){ toast('Código: ' + c); } }
async function crearCurso(){
  const nombre = document.getElementById('nc-nombre').value.trim();
  if(!nombre){ toast('Escribí el nombre del curso'); return; }
  document.getElementById('nc-btn').disabled = true;
  const { error } = await sb.from('cursos').insert({ institucion_id: INICIO.institucion.id, nombre });
  document.getElementById('nc-btn').disabled = false;
  if(error){ toast('No se pudo crear el curso'); console.warn(error); return; }
  await recargarDatos();
  if(!CURSO || !MIS_CURSOS().includes(CURSO)) CURSO = MIS_CURSOS()[0] || '';
  toast('Curso creado ✓'); pintar();
}
async function sumarEquipo(){
  const mail = document.getElementById('eq-mail').value.trim();
  if(!mail){ toast('Escribí el mail'); return; }
  const cursos = [...document.querySelectorAll('.eq-curso:checked')].map(x => x.value);
  document.getElementById('eq-btn').disabled = true;
  const { error } = await sb.rpc('agregar_al_equipo', { p_email: mail, p_rol: document.getElementById('eq-rol').value, p_cursos: cursos, p_nombre: document.getElementById('eq-nombre').value.trim() || null });
  document.getElementById('eq-btn').disabled = false;
  if(error){ toast(/todav[ií]a no cre[oó]/.test(error.message) ? 'Esa persona todavía no creó su cuenta en el panel' : 'No se pudo sumar'); console.warn(error); return; }
  toast('Listo ✓ Ya puede entrar al panel'); pintar();
}
Object.assign(window, { copiarCodigo, crearCurso, sumarEquipo });

function toast(t){
  const el = document.getElementById('toast');
  el.textContent = t; el.style.display = 'block';
  clearTimeout(toast.t); toast.t = setTimeout(() => { el.style.display = 'none'; }, 2600);
}

arrancar();
</script>
</body>
</html>
