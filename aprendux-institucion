          <td data-l="Forma principal">${f ? `<span class="forma"><i class="dot" style="background:${f.c}"></i>${f.nom} · ${pct(topK[1], cp.length)}%</span>` : '—'}</td>
          <td data-l="Alertas">${nAl ? `<span class="estado" style="color:var(--st-critico)">🔔 ${nAl}</span>` : '<span class="estado" style="color:var(--teal)">✓ 0</span>'}</td></tr>`;
      }).join('')}</tbody></table></div>`;
}

