<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Aprendux · Panel institucional</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#1e3a5f; --navy2:#2d5882; --blue-bg:#eef2f7; --orange:#f5a623; --white:#fff;
  --gray:#6b7a8d; --gray-light:#f8f9fb; --border:#d8e3ef; --teal:#1f7a5e; --teal-bg:#e2f2ef;
  --amber-bg:#faf1e2; --radius:10px; --radius-lg:16px; --shadow:0 2px 12px rgba(30,58,95,.09);
  /* formas de aprender (paleta categórica validada, orden fijo) */
  --f-visual:#2a78d6; --f-oral:#eb6834; --f-practica:#1baf7a; --f-lectura:#eda100; --f-otros:#e87ba4; --f-ordenar:#7a5af8;
  /* estado */
  --st-critico:#d03b3b; --st-serio:#ec835a; --st-aviso:#fab219; --st-ok:#0ca30c;
}
*{box-sizing:border-box}
body{margin:0;font-family:'Open Sans',sans-serif;color:var(--navy);background:var(--blue-bg);font-size:15px}
h1,h2,h3{font-family:'Montserrat',sans-serif;margin:0}
button{font-family:inherit}
.proto{background:var(--amber-bg);color:#8a5a00;text-align:center;font-size:13px;padding:6px 12px;font-weight:600}

/* barra de arriba */
.top{display:flex;align-items:center;gap:1rem;background:#fff;border-bottom:1px solid var(--border);padding:.6rem 1.4rem;position:sticky;top:0;z-index:20}
.top img{height:34px}
.top .inst{font-size:13px;color:var(--gray);line-height:1.2}
.top .inst b{display:block;color:var(--navy);font-size:14.5px}
.rol{margin-left:auto;display:flex;background:var(--blue-bg);border-radius:12px;padding:3px}
.rol button{border:0;background:none;padding:7px 14px;border-radius:9px;font-weight:700;font-size:14px;color:var(--gray);cursor:pointer}
.rol button.on{background:#fff;color:var(--navy);box-shadow:var(--shadow)}

/* layout */
.wrap{display:grid;grid-template-columns:220px 1fr;min-height:calc(100vh - 90px)}
.side{background:#fff;border-right:1px solid var(--border);padding:1rem .7rem;display:flex;flex-direction:column;gap:.25rem}
.side button{display:flex;align-items:center;gap:.6rem;border:0;background:none;text-align:left;padding:.7rem .8rem;border-radius:10px;font-size:15px;font-weight:700;color:var(--navy);cursor:pointer}
.side button.on{background:var(--navy);color:#fff}
.side .badge{margin-left:auto;background:var(--st-critico);color:#fff;font-size:12px;border-radius:20px;padding:1px 8px}
.main{padding:1.4rem 1.8rem 5rem;max-width:1180px;width:100%}
.titulo{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem}
.titulo h1{font-size:26px}
.titulo p{margin:.25rem 0 0;color:var(--gray)}
.cursos{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1.2rem}
.cursos button{border:1.5px solid var(--border);background:#fff;border-radius:20px;padding:7px 14px;font-weight:700;color:var(--navy);cursor:pointer;font-size:14px}
.cursos button.on{background:var(--navy);border-color:var(--navy);color:#fff}

/* tarjetas */
.card{background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.2rem 1.3rem}
.card h3{font-size:16.5px;margin-bottom:.2rem}
.card .sub{font-size:13.5px;color:var(--gray);margin:0 0 .9rem}
.grid{display:grid;gap:1rem}
.g2{grid-template-columns:1fr 1fr}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:.8rem;margin-bottom:1rem}
.kpi{background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);padding:1rem 1.1rem}
.kpi small{display:block;font-size:12.5px;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:.04em}
.kpi b{display:block;font-family:'Montserrat',sans-serif;font-size:30px;margin:.2rem 0 .1rem}
.kpi span{font-size:13px;color:var(--gray)}

/* barra 100% (cómo aprende el curso) */
.apilada{display:flex;height:34px;border-radius:8px;overflow:hidden;gap:2px;background:#fff}
.apilada div{height:100%;position:relative;cursor:default}
.leyenda{display:flex;flex-wrap:wrap;gap:.4rem 1rem;margin-top:.7rem;font-size:13.5px}
.leyenda span{display:inline-flex;align-items:center;gap:.4rem}
.dot{width:11px;height:11px;border-radius:3px;display:inline-block;flex:none}
.frase{background:var(--blue-bg);border-radius:12px;padding:.8rem 1rem;margin-top:1rem;font-size:15px;line-height:1.5}
.frase b{font-family:'Montserrat',sans-serif}

/* barras horizontales */
.hbar{display:grid;grid-template-columns:150px 1fr 48px;align-items:center;gap:.7rem;margin:.45rem 0;font-size:14px}
.hbar .pista{height:14px;background:var(--blue-bg);border-radius:4px;overflow:hidden}
.hbar .val{height:100%;border-radius:0 4px 4px 0}
.hbar b{text-align:right;font-variant-numeric:tabular-nums}

/* tooltip */
[data-tip]{position:relative}
[data-tip]:hover::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);background:var(--navy);color:#fff;font-size:12.5px;font-weight:600;padding:5px 9px;border-radius:7px;white-space:nowrap;z-index:30;pointer-events:none}

/* tabla de alumnos */
.buscar{width:100%;max-width:340px;border:1.5px solid var(--border);border-radius:10px;padding:9px 12px;font-size:15px;font-family:inherit}
.tabla{width:100%;border-collapse:separate;border-spacing:0;background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden}
.tabla th{font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--gray);text-align:left;padding:.7rem .9rem;background:var(--gray-light);border-bottom:1px solid var(--border)}
.tabla td{padding:.7rem .9rem;border-bottom:1px solid var(--border);font-size:14.5px;vertical-align:middle}
.tabla tr:last-child td{border-bottom:0}
.tabla tbody tr{cursor:pointer}
.tabla tbody tr:hover{background:var(--gray-light)}
.nombre{font-weight:700}
.forma{display:inline-flex;align-items:center;gap:.4rem;font-size:13.5px;font-weight:600}
.tests{display:flex;gap:4px}
.tchip{font-size:12px;font-weight:700;border-radius:6px;padding:2px 7px;background:var(--blue-bg);color:var(--gray)}
.tchip.ok{background:var(--teal-bg);color:var(--teal)}
.mini{height:8px;width:90px;background:var(--blue-bg);border-radius:6px;overflow:hidden;display:inline-block;vertical-align:middle;margin-right:6px}
.mini i{display:block;height:100%;background:var(--teal);border-radius:6px}
.estado{display:inline-flex;align-items:center;gap:.35rem;font-size:13px;font-weight:700}

/* alertas */
.alerta{display:flex;gap:.9rem;align-items:flex-start;background:#fff;border:1px solid var(--border);border-left:5px solid var(--c);border-radius:12px;padding:.9rem 1rem;margin-bottom:.6rem}
.alerta .ic{font-size:20px;line-height:1.2}
.alerta .tx{flex:1}
.alerta .tx b{display:block;font-size:15px}
.alerta .tx span{font-size:13.5px;color:var(--gray)}
.btn{border:0;background:var(--navy);color:#fff;border-radius:10px;padding:9px 16px;font-weight:700;cursor:pointer;font-size:14px}
.btn.claro{background:var(--blue-bg);color:var(--navy)}
.btn.chico{padding:6px 11px;font-size:13px}

/* formularios */
.campo{display:flex;flex-direction:column;gap:4px;margin-bottom:.8rem}
.campo label{font-size:13px;font-weight:700}
.campo input,.campo select,.campo textarea{border:1.5px solid var(--border);border-radius:9px;padding:9px 11px;font-size:15px;font-family:inherit;color:var(--navy);background:#fff}
.fila2{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.examen{display:flex;justify-content:space-between;align-items:center;gap:.8rem;padding:.75rem 0;border-bottom:1px solid var(--border)}
.examen:last-child{border-bottom:0}
.examen b{display:block}
.examen span{font-size:13.5px;color:var(--gray)}
.nota-in{width:70px;border:1.5px solid var(--border);border-radius:8px;padding:6px 8px;font-size:15px;text-align:center;font-family:inherit}

/* ficha del alumno */
.velo{display:none;position:fixed;inset:0;background:rgba(11,31,59,.45);z-index:50}
.ficha{position:fixed;top:0;right:0;height:100%;width:min(520px,100%);background:var(--gray-light);z-index:51;overflow-y:auto;transform:translateX(100%);transition:transform .25s ease;padding:1.3rem 1.3rem 3rem}
.ficha.abierta{transform:none}
.ficha .cerrar{position:absolute;top:1rem;right:1rem;border:0;background:#fff;width:36px;height:36px;border-radius:50%;font-size:18px;cursor:pointer;box-shadow:var(--shadow)}
.ficha h2{font-size:22px;padding-right:3rem}
.ficha .card{margin-top:.9rem}
.consejo{background:var(--teal-bg);border-radius:12px;padding:.8rem 1rem;font-size:14.5px;line-height:1.5;margin-top:.8rem}
.toast{position:fixed;bottom:1.4rem;left:50%;transform:translateX(-50%);background:var(--navy);color:#fff;padding:.8rem 1.2rem;border-radius:12px;font-weight:700;z-index:60;display:none;box-shadow:var(--shadow)}
.vacio{text-align:center;color:var(--gray);padding:2rem}

/* celu */
@media (max-width: 860px){
  .top{padding:.5rem 1rem;flex-wrap:wrap}
  .top img{height:28px}
  .rol{margin-left:0;width:100%}
  .rol button{flex:1}
  .wrap{grid-template-columns:1fr}
  .side{position:fixed;bottom:0;left:0;right:0;flex-direction:row;border-right:0;border-top:1px solid var(--border);padding:.35rem;z-index:40;justify-content:space-around}
  .side button{flex-direction:column;gap:2px;font-size:11.5px;padding:.45rem .3rem;flex:1;align-items:center;position:relative}
  .side button .ic{font-size:20px}
  .side .badge{position:absolute;top:2px;right:12%;margin:0;font-size:10.5px;padding:0 6px}
  .main{padding:1rem 1rem 6rem}
  .titulo h1{font-size:22px}
  .g2,.fila2{grid-template-columns:1fr}
  .hbar{grid-template-columns:110px 1fr 42px}
  .tabla thead{display:none}
  .tabla,.tabla tbody,.tabla tr,.tabla td{display:block;width:100%}
  .tabla tr{border-bottom:1px solid var(--border);padding:.6rem .2rem}
  .tabla td{border:0;padding:.2rem .8rem}
  .tabla td[data-l]::before{content:attr(data-l) ': ';font-size:12px;color:var(--gray);font-weight:700}
}

/* login y estados */
.login{max-width:400px;margin:8vh auto;background:#fff;border-radius:var(--radius-lg);box-shadow:var(--shadow);padding:2rem 1.8rem}
.login img{height:40px;display:block;margin:0 auto 1rem}
.login h1{font-size:21px;text-align:center;margin-bottom:.3rem}
.login p{color:var(--gray);text-align:center;font-size:14px;margin:.2rem 0 1.2rem}
.login .btn{width:100%;margin-top:.4rem;padding:11px}
.login .link{display:block;text-align:center;margin-top:1rem;color:var(--navy2);font-weight:700;font-size:14px;cursor:pointer;background:none;border:0;width:100%}
.login .err{color:var(--st-critico);font-size:13.5px;margin:.5rem 0 0;min-height:1em;text-align:center}
.cargando{text-align:center;color:var(--gray);padding:3rem 1rem}
.yo{margin-left:auto;display:flex;align-items:center;gap:.7rem;font-size:13px;color:var(--gray);text-align:right;line-height:1.25}
.yo b{display:block;color:var(--navy);font-size:14px}
.codigo{font-family:'Montserrat',monospace;font-weight:800;letter-spacing:.12em;background:var(--blue-bg);border-radius:8px;padding:3px 9px;color:var(--navy);font-size:15px}
.cod-fila{display:flex;align-items:center;justify-content:space-between;gap:.6rem;padding:.55rem 0;border-bottom:1px solid var(--border)}
.cod-fila:last-child{border-bottom:0}
.checks{display:flex;flex-wrap:wrap;gap:.3rem .9rem;margin:.3rem 0 .6rem;font-size:14px}
@media (max-width: 860px){ .yo{margin-left:0;width:100%;justify-content:space-between;text-align:left} }
</style>
</head>
<body>
<div id="pantalla-login"></div>
<div id="app" style="display:none">
<header class="top">
  <img src="https://raw.githubusercontent.com/APRENDUX/aprendux/main/LogoAprendux-02.png" alt="Aprendux">
  <div class="inst"><b id="nombre-inst">…</b>Panel institucional</div>
  <div class="yo"><div><b id="nombre-yo"></b><span id="rol-yo"></span></div>
    <button type="button" class="btn claro chico" onclick="salir()">Salir</button></div>
</header>

<div class="wrap">
  <nav class="side" aria-label="Secciones">
    <button type="button" data-v="resumen" class="on" onclick="ir('resumen')"><span class="ic">📊</span>Resumen</button>
    <button type="button" data-v="alumnos" onclick="ir('alumnos')"><span class="ic">👧</span>Alumnos</button>
    <button type="button" data-v="alertas" onclick="ir('alertas')"><span class="ic">🔔</span>Alertas<span class="badge" id="badge-alertas"></span></button>
    <button type="button" data-v="examenes" onclick="ir('examenes')"><span class="ic">📝</span>Exámenes y notas</button>
    <button type="button" data-v="cursos" onclick="ir('cursos')"><span class="ic">🏫</span>Cursos y códigos</button>
  </nav>
  <main class="main" id="main"></main>
</div>

</div>

<div class="velo" id="velo" onclick="cerrarFicha()"></div>
<aside class="ficha" id="ficha" aria-label="Ficha del alumno"></aside>
<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script>
// ══════════════════════════════════════════════════════════════
//  CONEXIÓN
//  Los datos salen de Supabase por las funciones panel_inicio() y panel_alumnos()
//  (supabase_v9_6_institucion.sql). Nunca se lee el cluster ni el texto de la IA:
//  solo las formas de aprender, en porcentaje.
// ══════════════════════════════════════════════════════════════
const SUPABASE_URL = 'https://ihxyqpqfhphqchrkihoe.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_jNlO3gKJ0RpFjRmMbiy0lw_g8gmPCIG';
const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

const FORMAS = [
  { k: 'visual',   nom: 'Visual',              corto: 'viendo',                c: 'var(--f-visual)',   consejo: 'Usá esquemas, mapas y colores en el pizarrón. Le sirve ver la información ordenada.' },
  { k: 'oral',     nom: 'Oral',                corto: 'escuchando y hablando', c: 'var(--f-oral)',     consejo: 'Explicá en voz alta y dale espacio para que cuente lo que entendió. Le sirven los audios y los debates.' },
  { k: 'practica', nom: 'Práctica',            corto: 'haciendo',              c: 'var(--f-practica)', consejo: 'Proponé ejercicios, ejemplos reales y actividades con las manos antes de la teoría.' },
  { k: 'lectura',  nom: 'Lectura y escritura', corto: 'leyendo y escribiendo', c: 'var(--f-lectura)',  consejo: 'Dale textos para leer y pedile resúmenes escritos. Le ayuda tomar apuntes propios.' },
  { k: 'ordenar',  nom: 'Organizada',          corto: 'con todo ordenado',     c: 'var(--f-ordenar)',  consejo: 'Presentá los temas en pasos, cuadros y listas. Le sirve ver la estructura antes de los detalles.' },
  { k: 'otros',    nom: 'Con otros',           corto: 'con otros',             c: 'var(--f-otros)',    consejo: 'Armá trabajos en grupo o en parejas. Aprende mejor cuando lo charla con compañeros.' }
];
// perfil_grafico (niveles 1 a 3) → forma del panel
const DE_NIVELES = { ver: 'visual', escuchar: 'oral', hacer: 'practica', leer: 'lectura', ordenar: 'ordenar', con_otros: 'otros' };
const MATERIAS_BASE = ['Historia','Matemática','Biología','Lengua','Química','Física','Geografía','Inglés','Formación ética'];

let YO = null;                 // { id, email }
let INICIO = null;             // { rol, nombre, institucion, cursos: [{id, nombre, codigo, alumnos}] }
let CURSOS = [];               // nombres
let CURSO_INFO = {};           // nombre → { id, codigo, alumnos }
let ALUMNOS = [];
let EXAMENES = [];
let MATERIAS = MATERIAS_BASE.slice();
let VISTAS = new Set();

const HOY = new Date(); HOY.setHours(0,0,0,0);
function enDias(n){ const d = new Date(HOY); d.setDate(d.getDate() + n); return d.toISOString().slice(0,10); }
function fechaCorta(f){ const d = new Date(String(f).slice(0,10) + 'T00:00:00'); return d.getDate() + '/' + (d.getMonth() + 1); }
function diasHasta(f){ return Math.round((new Date(String(f).slice(0,10) + 'T00:00:00') - HOY) / 86400000); }
function esc(s){ return String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c])); }
function jsq(s){ return esc(String(s).replace(/\\/g, '\\\\').replace(/'/g, "\\'")); }
function pct(n, d){ return d ? Math.round(n / d * 100) : 0; }
function num(v){ const n = Number(String(v ?? '').replace(',', '.')); return v === null || v === '' || isNaN(n) ? null : n; }
function fmtNota(n){ return String(Math.round(n * 100) / 100).replace('.', ','); }

// Alertas marcadas como vistas: solo en este navegador
function claveVistas(){ return 'aprendux-inst-vistas-' + (YO ? YO.id : ''); }
function leerVistas(){ try { VISTAS = new Set(JSON.parse(localStorage.getItem(claveVistas()) || '[]')); } catch(e){ VISTAS = new Set(); } }
function guardarVistas(){ try { localStorage.setItem(claveVistas(), JSON.stringify([...VISTAS])); } catch(e){} }

// ══════════════════════════════════════════════════════════════
//  LOGIN
// ══════════════════════════════════════════════════════════════
let MODO_LOGIN = 'entrar';
function pantallaLogin(msj){
  document.getElementById('app').style.display = 'none';
  const crear = MODO_LOGIN === 'crear';
  document.getElementById('pantalla-login').innerHTML = `
    <form class="login" onsubmit="event.preventDefault(); ${crear ? 'crearCuenta()' : 'entrar()'}">
      <img src="https://raw.githubusercontent.com/APRENDUX/aprendux/main/LogoAprendux-02.png" alt="Aprendux">
      <h1>${crear ? 'Crear tu cuenta' : 'Panel institucional'}</h1>
      <p>${crear ? 'Para docentes y directivos. Después tu escuela te habilita.' : 'Para docentes y directivos'}</p>
      ${crear ? `<div class="campo"><label for="l-nombre">Nombre y apellido</label><input id="l-nombre" autocomplete="name" required></div>` : ''}
      <div class="campo"><label for="l-mail">Mail</label><input id="l-mail" type="email" autocomplete="email" required></div>
      <div class="campo"><label for="l-pass">Contraseña</label><input id="l-pass" type="password" minlength="6" autocomplete="${crear ? 'new-password' : 'current-password'}" required></div>
      <button class="btn" type="submit" id="l-btn">${crear ? 'Crear cuenta' : 'Entrar'}</button>
      <p class="err" id="l-err">${esc(msj || '')}</p>
      <button type="button" class="link" onclick="MODO_LOGIN='${crear ? 'entrar' : 'crear'}';pantallaLogin()">${crear ? 'Ya tengo cuenta' : 'No tengo cuenta: crear una'}</button>
    </form>`;
}
function errorLogin(t){ document.getElementById('l-err').textContent = t; const b = document.getElementById('l-btn'); if(b) b.disabled = false; }
async function entrar(){
  document.getElementById('l-btn').disabled = true;
  const { error } = await sb.auth.signInWithPassword({ email: document.getElementById('l-mail').value.trim(), password: document.getElementById('l-pass').value });
  if(error) return errorLogin(/invalid/i.test(error.message) ? 'El mail o la contraseña no coinciden.' : /confirm/i.test(error.message) ? 'Primero confirmá tu mail: te llegó un link.' : error.message);
  arrancar();
}
async function crearCuenta(){
  document.getElementById('l-btn').disabled = true;
  const nombre = document.getElementById('l-nombre').value.trim();
  const { data, error } = await sb.auth.signUp({ email: document.getElementById('l-mail').value.trim(), password: document.getElementById('l-pass').value, options: { data: { nombre, panel: 'institucion' } } });
  if(error) return errorLogin(error.message);
  if(!data.session){ MODO_LOGIN = 'entrar'; pantallaLogin('Listo. Te mandamos un mail para confirmar la cuenta; después entrá desde acá.'); return; }
  arrancar();
}
async function salir(){ await sb.auth.signOut(); YO = null; INICIO = null; MODO_LOGIN = 'entrar'; pantallaLogin(); }
Object.assign(window, { entrar, crearCuenta, salir, pantallaLogin });

// ══════════════════════════════════════════════════════════════
//  CARGA DE DATOS
// ══════════════════════════════════════════════════════════════
async function arrancar(){
  const { data: { user } } = await sb.auth.getUser();
  if(!user){ pantallaLogin(); return; }
  YO = { id: user.id, email: user.email };
  document.getElementById('pantalla-login').innerHTML = '<div class="cargando">Cargando…</div>';
  const { data: ini, error } = await sb.rpc('panel_inicio');
  if(error){ pantallaLogin('No pudimos abrir el panel: ' + error.message); return; }
  if(!ini || !ini.rol){
    document.getElementById('pantalla-login').innerHTML = `<div class="login">
      <img src="https://raw.githubusercontent.com/APRENDUX/aprendux/main/LogoAprendux-02.png" alt="Aprendux">
      <h1>Tu cuenta todavía no está habilitada</h1>
      <p>Pedile a un directivo de tu escuela que te sume al equipo con este mail:<br><b>${esc(user.email)}</b></p>
      <p>Si sos directivo y tu escuela recién empieza, escribile al equipo de Aprendux.</p>
      <button class="btn" onclick="arrancar()">Ya me sumaron, volver a probar</button>
      <button class="link" onclick="salir()">Salir</button></div>`;
    return;
  }
  INICIO = ini;
  leerVistas();
  await recargarDatos();
  document.getElementById('pantalla-login').innerHTML = '';
  document.getElementById('app').style.display = '';
  document.getElementById('nombre-inst').textContent = ini.institucion.nombre;
  document.getElementById('nombre-yo').textContent = ini.nombre || user.email;
  document.getElementById('rol-yo').textContent = ini.rol === 'directivo' ? '🏫 Directivo' : '👩‍🏫 Docente';
  ROL = ini.rol;
  if(!CURSOS.length) VISTA = 'cursos';
  CURSO = MIS_CURSOS()[0] || '';
  marcarNav();
  pintar();
}
window.arrancar = arrancar;

async function recargarDatos(){
  const { data: ini } = await sb.rpc('panel_inicio');
  if(ini && ini.rol) INICIO = ini;
  CURSOS = (INICIO.cursos || []).map(c => c.nombre);
  CURSO_INFO = Object.fromEntries((INICIO.cursos || []).map(c => [c.nombre, c]));
  const nombrePorId = Object.fromEntries((INICIO.cursos || []).map(c => [c.id, c.nombre]));

  const [{ data: al, error: e1 }, { data: ex, error: e2 }] = await Promise.all([
    sb.rpc('panel_alumnos'),
    sb.from('examenes_curso').select('id, curso_id, materia, titulo, fecha, tipo, modalidad, temas').order('fecha')
  ]);
  if(e1) toast('No se pudieron cargar los alumnos');
  if(e2) toast('No se pudieron cargar los exámenes');
  ALUMNOS = (al || []).map(convertirAlumno);
  EXAMENES = (ex || []).map(e => ({ ...e, curso: nombrePorId[e.curso_id] || '', tipoTxt: e.tipo === 'Entrega' ? 'TP / entrega' : e.modalidad === 'oral' ? 'Oral' : 'Escrito' }));
  const vistas = new Set(MATERIAS_BASE);
  ALUMNOS.forEach(a => [...a.planes, ...a.notas].forEach(x => { if(x.materia) vistas.add(x.materia); }));
  EXAMENES.forEach(e => { if(e.materia) vistas.add(e.materia); });
  MATERIAS = [...vistas];
}

function convertirAlumno(a){
  let perfil = null;
  if(a.perfil && typeof a.perfil === 'object'){
    const niveles = Object.entries(DE_NIVELES).map(([n, k]) => [k, Number(a.perfil[n]) || 0]);
    const tot = niveles.reduce((s, [, v]) => s + v, 0);
    if(tot > 0){
      perfil = Object.fromEntries(niveles.map(([k, v]) => [k, Math.round(v / tot * 100)]));
      const mayor = Object.entries(perfil).sort((x, y) => y[1] - x[1])[0][0];
      perfil[mayor] += 100 - Object.values(perfil).reduce((s, v) => s + v, 0);
    }
  }
  const ultima = a.ultima_visita ? Math.max(0, Math.floor((Date.now() - new Date(a.ultima_visita)) / 86400000)) : null;
  return {
    id: a.id, nombre: a.nombre || 'Sin nombre', curso: a.curso, curso_id: a.curso_id, perfil,
    tests: { estilos: !!a.estilos, rc1: num(a.rc1), rc2: num(a.rc2) },
    planes: (a.planes || []).filter(p => p.total > 0).map(p => ({ materia: p.materia || p.titulo, fecha: p.fecha, total: p.total, hechos: Math.min(p.hechos, p.total) })),
    notas: (a.notas || []).map(n => ({ materia: n.materia || '', titulo: n.titulo || 'Nota', nota: Number(n.nota), fecha: n.fecha, origen: n.origen })),
    ultima, autoevaluaciones: a.autoevaluaciones || 0
  };
}

