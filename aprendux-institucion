let ROL = 'docente', VISTA = 'resumen', CURSO = '', BUSCA = '';
function MIS_CURSOS(){ return ROL === 'directivo' || CURSOS.length > 1 ? [ROL === 'directivo' ? 'Toda la escuela' : 'Todos mis cursos', ...CURSOS] : CURSOS; }
function esTodos(){ return CURSO === 'Toda la escuela' || CURSO === 'Todos mis cursos'; }

function alumnosDelCurso(){ return esTodos() ? ALUMNOS : ALUMNOS.filter(a => a.curso === CURSO); }
function predominante(a){
  if(!a.perfil) return null;
  const k = Object.entries(a.perfil).sort((x, y) => y[1] - x[1])[0];
  return { ...FORMAS.find(f => f.k === k[0]), pct: k[1] };
}
function textoUltima(a, mayus){
  const t = a.ultima === null ? 'todavía no entró' : a.ultima === 0 ? 'hoy' : 'hace ' + a.ultima + ' día' + (a.ultima > 1 ? 's' : '');
  return mayus ? t.charAt(0).toUpperCase() + t.slice(1) : t;
}

function alertasDe(a){
  const l = [];
  if(a.ultima === null) l.push({ nivel: 'aviso', ic: '🟡', txt: 'Todavía no entró a Aprendux', det: 'Se sumó al curso pero no abrió la plataforma.' });
  else if(a.ultima >= 7) l.push({ nivel: 'critico', ic: '⛔', txt: `No entra hace ${a.ultima} días`, det: 'Puede necesitar un empujón para retomar.' });
  a.planes.forEach(p => {
    const d = diasHasta(p.fecha);
    if(d >= 0 && d <= 3 && p.hechos === 0) l.push({ nivel: 'serio', ic: '⚠️', txt: `${p.materia}: examen ${d === 0 ? 'hoy' : 'en ' + d + ' días'} y no empezó el plan`, det: `0 de ${p.total} días hechos.` });
  });
  if(!a.tests.estilos) l.push({ nivel: 'aviso', ic: '🟡', txt: 'Le falta el test de estilos', det: 'Sin ese test no tiene su forma de aprender ni su plan a medida.' });
  a.notas.forEach(n => { if(n.nota < 6 && diasHasta(n.fecha) >= -30) l.push({ nivel: 'serio', ic: '📉', txt: `Sacó ${fmtNota(n.nota)} en ${n.materia || n.titulo}`, det: 'Podría venirle bien un plan de repaso.', clave: 'nota-' + n.materia + n.titulo + n.fecha }); });
  // la clave de la alerta no depende del orden: así "Visto" se mantiene al recargar
  return l.map(x => ({ ...x, id: a.id + '-' + (x.clave || x.txt), alumno: a }));
}
const COLOR_NIVEL = { critico: 'var(--st-critico)', serio: 'var(--st-serio)', aviso: 'var(--st-aviso)' };
const NOMBRE_NIVEL = { critico: 'Urgente', serio: 'Importante', aviso: 'Para revisar' };

