function vistaResumen(){
  const al = alumnosDelCurso(), n = al.length;
  const cab = `<div class="titulo"><div><h1>📊 ${esTodos() ? esc(CURSO) : 'Resumen de ' + esc(CURSO)}</h1>
      <p>¿Cómo viene el curso esta semana?</p></div></div>${chipsCursos()}`;
  if(!n) return cab + sinAlumnos();
  const activos = al.filter(a => a.ultima !== null && a.ultima <= 6).length;
  const conPerfil = al.filter(a => a.perfil);
  const completos = al.filter(a => a.tests.estilos && a.tests.rc1 !== null && a.tests.rc2 !== null).length;
  const planes = al.reduce((s, a) => s + a.planes.filter(p => diasHasta(p.fecha) >= 0).length, 0);
  const alertas = al.flatMap(alertasDe).filter(x => !VISTAS.has(x.id)).length;

  const cuenta = Object.fromEntries(FORMAS.map(f => [f.k, 0]));
  conPerfil.forEach(a => cuenta[predominante(a).k]++);
  const top = FORMAS.map(f => ({ ...f, n: cuenta[f.k], p: pct(cuenta[f.k], conPerfil.length) })).sort((a, b) => b.n - a.n)[0];
  const prom = FORMAS.map(f => ({ ...f, p: conPerfil.length ? Math.round(conPerfil.reduce((s, a) => s + a.perfil[f.k], 0) / conPerfil.length) : 0 }));

  const rc1 = al.filter(a => a.tests.rc1 !== null), rc2 = al.filter(a => a.tests.rc2 !== null);
  const promRc = (l, k) => l.length ? (l.reduce((s, a) => s + a.tests[k], 0) / l.length).toFixed(1).replace('.', ',') : '—';

  return cab + `
    <div class="kpis">
      <div class="kpi"><small>Alumnos</small><b>${n}</b><span>${conPerfil.length} con su forma de aprender</span></div>
      <div class="kpi"><small>Entraron esta semana</small><b>${pct(activos, n)}%</b><span>${activos} de ${n}</span></div>
      <div class="kpi"><small>Hicieron los 3 tests</small><b>${pct(completos, n)}%</b><span>${completos} de ${n}</span></div>
      <div class="kpi"><small>Planes de estudio activos</small><b>${planes}</b><span>exámenes con plan armado</span></div>
      <div class="kpi" style="cursor:pointer" onclick="ir('alertas')"><small>Alertas</small><b style="color:${alertas ? 'var(--st-critico)' : 'var(--teal)'}">${alertas}</b><span>${alertas ? 'Ver alertas →' : 'Todo en orden'}</span></div>
    </div>

    <div class="grid g2">
      <div class="card">
        <h3>🧠 Cómo aprende el curso</h3>
        <p class="sub">Forma principal de aprender de cada alumno · ${conPerfil.length} alumnos con el test hecho</p>
        ${conPerfil.length ? `
        <div class="apilada" role="img" aria-label="Distribución de formas de aprender">
          ${FORMAS.filter(f => cuenta[f.k]).map(f => `<div style="width:${pct(cuenta[f.k], conPerfil.length)}%;background:${f.c}" data-tip="${f.nom}: ${pct(cuenta[f.k], conPerfil.length)}% (${cuenta[f.k]} alumnos)"></div>`).join('')}
        </div>
        <div class="leyenda">${FORMAS.map(f => `<span><i class="dot" style="background:${f.c}"></i>${f.nom} <b>${pct(cuenta[f.k], conPerfil.length)}%</b></span>`).join('')}</div>
        ${top && top.n ? `<div class="frase">El <b>${top.p}%</b> de ${esTodos() ? (ROL === 'directivo' ? 'la escuela' : 'tus cursos') : esc(CURSO)} aprende mejor de manera <b>${top.nom.toLowerCase()}</b>. ${esc(top.consejo)}</div>` : ''}`
        : '<p class="sub">Cuando los alumnos hagan el test de estilos, acá vas a ver cómo aprende el curso.</p>'}
      </div>
      <div class="card">
        <h3>📐 Promedio de cada forma</h3>
        <p class="sub">Cuánto se apoya el curso, en promedio, en cada forma de aprender</p>
        ${prom.map(f => `<div class="hbar"><span style="display:flex;align-items:center;gap:.4rem"><i class="dot" style="background:${f.c}"></i>${f.nom}</span>
          <div class="pista" data-tip="${f.nom}: ${f.p}%"><div class="val" style="width:${f.p}%;background:${f.c}"></div></div><b>${f.p}%</b></div>`).join('')}
      </div>
      <div class="card">
        <h3>📝 Tests</h3>
        <p class="sub">Qué parte del curso ya hizo cada test</p>
        ${[['Estilos de aprendizaje', al.filter(a => a.tests.estilos).length], ['Razonamiento crítico 1', rc1.length], ['Razonamiento crítico 2', rc2.length]].map(([t, c]) =>
          `<div class="hbar"><span>${t}</span><div class="pista" data-tip="${c} de ${n} alumnos"><div class="val" style="width:${pct(c, n)}%;background:var(--navy2)"></div></div><b>${pct(c, n)}%</b></div>`).join('')}
      </div>
      <div class="card">
        <h3>🎯 Razonamiento crítico</h3>
        <p class="sub">Promedio del curso (sobre 10)</p>
        <div class="kpis" style="margin:0">
          <div class="kpi" style="background:var(--gray-light)"><small>RC1</small><b>${promRc(rc1, 'rc1')}</b><span>${rc1.length} alumno${rc1.length === 1 ? '' : 's'}</span></div>
          <div class="kpi" style="background:var(--gray-light)"><small>RC2</small><b>${promRc(rc2, 'rc2')}</b><span>${rc2.length} alumno${rc2.length === 1 ? '' : 's'}</span></div>
        </div>
      </div>
    </div>
    ${esTodos() && CURSOS.length > 1 ? tablaCursos() : ''}`;
}

function tablaCursos(){
  return `<div class="card" style="margin-top:1rem;padding:0;overflow:hidden">
    <div style="padding:1.1rem 1.3rem .4rem"><h3>🏫 Por curso</h3><p class="sub">Tocá un curso para ver su detalle</p></div>
    <table class="tabla" style="border:0;border-radius:0">
